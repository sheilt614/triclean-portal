# Copy to .env for local development. On Render, set these in the dashboard.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Leave unset locally to use a SQLite file (triclean.db). On Render: the Neon Postgres URL.
DATABASE_URL=
# Used to print the set-password link for the first admin (flask create-admin).
PUBLIC_BASE_URL=http://localhost:5000
COMPANY_PHONE=(917) 582-9876
COMPANY_EMAIL=
COMPANY_ADDRESS=5644 Netherland Ave, Bronx, NY
